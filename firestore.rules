rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() && myUser().data.role is string ? myUser().data.role : 'staff';
    }

    function isOwnerOrAdmin() {
      return signedIn() && (myRole() == 'owner' || myRole() == 'admin');
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canViewStock() {
      return isOwnerOrAdmin()
        || (signedIn() && (
          myUser().data.canViewStock == true
          || myUser().data.permissions.stock == true
          || myUser().data.permissions.stockView == true
        ));
    }

    function isStaffAllowedExpense() {
      return signedIn()
        && request.resource.data.branchId == myUser().data.branch
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cat in ['🚗', '💡', '💰'];
    }

    match /users/{uid} {
      allow read: if isOwnerOrAdmin() || isSelf(uid);
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /records/{id} {
      allow read: if isOwnerOrAdmin()
        || (signedIn() && resource.data.branchId == myUser().data.branch);
      allow create: if signedIn();
      allow update, delete: if isOwnerOrAdmin()
        || (signedIn() && resource.data.userUid == request.auth.uid);
    }

    match /checkin_logs/{id} {
      allow read: if isOwnerOrAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwnerOrAdmin();
    }

    match /stock/{id} {
      allow read: if canViewStock();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /menus/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /branches/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /employees/{id} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isOwnerOrAdmin();
    }

    match /daily_closings/{id} {
      allow read: if isOwnerOrAdmin();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /cash_expenses/{id} {
      allow read: if isOwnerOrAdmin()
        || (signedIn() && resource.data.branchId == myUser().data.branch);
      allow create: if isOwnerOrAdmin() || isStaffAllowedExpense();
      allow update, delete: if isOwnerOrAdmin();
    }

    match /stock_movements/{id} {
      allow read: if canViewStock();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /stock_adjustments/{id} {
      allow read: if canViewStock();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /_meta/{id} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
